# Required: Anthropic API key for answer generation and the evaluation judge.
ANTHROPIC_API_KEY=sk-ant-...

# --- Models -----------------------------------------------------------------
# Model used to generate grounded answers.
ANSWER_MODEL=claude-opus-5
# Model used as the groundedness judge in the evaluation loop.
JUDGE_MODEL=claude-opus-5
MAX_TOKENS=8000

# --- Embeddings -------------------------------------------------------------
# fastembed (default, local) | voyage | huggingface
EMBEDDING_PROVIDER=fastembed
# fastembed  -> BAAI/bge-small-en-v1.5
# voyage     -> voyage-3
# huggingface-> sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Only needed when EMBEDDING_PROVIDER=voyage
# VOYAGE_API_KEY=pa-...

# --- Chunking & retrieval ---------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
# Drop retrieved chunks whose relevance score falls below this (0.0 disables).
# Applied to vector scores *before* reranking — keep it at 0.0 when reranking is
# on, or you may filter out a passage the reranker would have promoted.
SCORE_THRESHOLD=0.0

# --- Reranking --------------------------------------------------------------
# Second stage: fetch RERANK_CANDIDATES passages, score each one against the
# question with a cross-encoder, keep the best TOP_K.
# none (default, disabled) | fastembed (local) | voyage | huggingface | llm
# fastembed downloads ~90 MB on first use, then caches it.
RERANK_PROVIDER=none
# Leave empty to use the provider default:
# fastembed  -> Xenova/ms-marco-MiniLM-L-6-v2
# voyage     -> rerank-2-lite
# huggingface-> cross-encoder/ms-marco-MiniLM-L-6-v2
# llm        -> ANSWER_MODEL
RERANK_MODEL=
# Candidates pulled from the vector store before reranking. Never fewer than the
# requested TOP_K.
RERANK_CANDIDATES=20

# --- Hybrid retrieval -------------------------------------------------------
# dense (default, embeddings only) | hybrid (embeddings + BM25, fused by RRF)
# Hybrid adds a lexical channel that matches exact tokens — figures, codes,
# product names — which embeddings routinely miss. No extra dependency or key.
RETRIEVAL_MODE=dense
# Reciprocal-rank-fusion damping. Lower = the top of each channel dominates
# more; higher = agreement between channels matters more.
RRF_K=60
# Okapi BM25 term-saturation and length-normalisation constants.
BM25_K1=1.5
BM25_B=0.75

# --- Citations --------------------------------------------------------------
# markers (default) -> the model writes inline [n] and we parse them back
# native            -> the Anthropic Citations API returns exact character
#                      spans, so a citation cannot point at text that is not
#                      there. Answers carry no inline [n] in this mode.
CITATION_MODE=markers

# --- Paths ------------------------------------------------------------------
DOCS_DIR=data/docs
PERSIST_DIR=.chroma
COLLECTION_NAME=rag_documents
